<style>
  .lodge-card:hover .card-img { transform: scale(1.05); }
  .save-btn.saved svg { fill: #55142A; stroke: #55142A; }
  .community-title { font-family: 'Cormorant Garamond', serif; }
</style>

<div class="flex flex-col gap-16 px-4 sm:px-6 lg:px-8 py-10">

  <% const communities = [
    {
      name: 'Umuchima', label: 'Community',
      lodges: [
        { id:1,  name:'Sunrise Lodge',  price:120000, rating:'4.8', img:'/images/lodge1.jpg' },
        { id:2,  name:'Prime Lodge',    price:150000, rating:'4.6', img:'/images/lodge2.jpg' },
        { id:3,  name:'Elite Stay',     price:180000, rating:'4.9', img:'/images/lodge3.jpg' },
        { id:4,  name:'Budget Lodge',   price:90000,  rating:'4.3', img:'/images/lodge4.jpg' },
      ]
    },
    {
      name: 'Eziobodo', label: 'Community',
      lodges: [
        { id:5,  name:'Royal Lodge',    price:130000, rating:'4.7', img:'/images/lodge5.jpg' },
        { id:6,  name:'Green View',     price:110000, rating:'4.4', img:'/images/lodge6.jpg' },
        { id:7,  name:'Cedar Hostel',   price:95000,  rating:'4.2', img:'/images/lodge7.jpg' },
        { id:8,  name:'The Retreat',    price:160000, rating:'4.8', img:'/images/lodge8.jpg' },
      ]
    },
    {
      name: 'Ihiagwa', label: 'Community',
      lodges: [
        { id:9,  name:'Palm Court',     price:105000, rating:'4.5', img:'/images/lodge9.jpg' },
        { id:10, name:'Haven Lodge',    price:140000, rating:'4.7', img:'/images/lodge10.jpg' },
        { id:11, name:'Campus View',    price:85000,  rating:'4.1', img:'/images/lodge11.jpg' },
        { id:12, name:'Silver Hostel',  price:125000, rating:'4.6', img:'/images/lodge12.jpg' },
      ]
    },
  ] %>

  <% communities.forEach(function(community) { %>
  <section>

    <div class="flex items-center justify-between gap-4 mb-6">
      <div>
        <p class="text-[11px] font-medium text-gray-400 uppercase tracking-widest mb-1"><%= community.label %></p>
        <h2 class="community-title text-2xl font-medium text-gray-900"><%= community.name %> Lodges</h2>
      </div>
      <a href="/lodges?community=<%= community.name.toLowerCase() %>"
         class="shrink-0 text-xs font-medium text-[#55142A] border border-[#55142A]/25 px-4 py-1.5 rounded-full transition-colors duration-150 hover:bg-[#55142A] hover:text-white">
        View all →
      </a>
    </div>


    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
      <% community.lodges.forEach(function(lodge) { %>

      <a href="/select-lodge/<%= lodge.id %>"
         class="lodge-card group relative flex flex-col bg-white rounded-2xl border border-black/[0.06] overflow-hidden no-underline text-inherit transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_12px_36px_rgba(85,20,42,0.1)]">

        
        <button class="save-btn absolute top-2.5 right-2.5 z-10 w-9 h-9 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center shadow-sm border-none cursor-pointer transition-transform duration-200 hover:scale-110 hover:bg-white"
                data-id="<%= lodge.id %>"
                onclick="event.preventDefault(); toggleSave(this)"
                aria-label="Save lodge">
          <svg class="w-4 h-4" fill="none" stroke="#55142A" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
          </svg>
        </button>

       
        <div class="overflow-hidden w-full h-48 shrink-0">
          <img src="<%= lodge.img %>" alt="<%= lodge.name %>"
               class="card-img w-full h-full object-cover transition-transform duration-500"
               loading="lazy" />
        </div>

        
        <div class="flex flex-col gap-1 p-4">
          <h3 class="text-sm font-medium text-gray-900 leading-snug"><%= lodge.name %></h3>
          <p class="text-xs text-gray-400"><%= community.name %></p>

          
          <div class="flex items-center gap-1 mt-1">
            <svg class="w-3 h-3 fill-amber-400 shrink-0" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            <span class="text-xs font-medium text-gray-700"><%= lodge.rating %></span>
          </div>

          
          <p class="text-sm font-semibold text-[#55142A] mt-2 text-right">
            ₦<%= lodge.price.toLocaleString() %>
            <span class="text-[11px] font-normal text-gray-400">/ year</span>
          </p>
        </div>
      </a>

      <% }); %>
    </div>
  </section>
  <% }); %>

</div>

<script>
  const savedIds = new Set(JSON.parse(localStorage.getItem('uponthee_saved') || '[]'));

  document.querySelectorAll('.save-btn').forEach(btn => {
    if (savedIds.has(Number(btn.dataset.id))) btn.classList.add('saved');
  });

  function toggleSave(btn) {
    const id = Number(btn.dataset.id);
    if (savedIds.has(id)) {
      savedIds.delete(id);
      btn.classList.remove('saved');
    } else {
      savedIds.add(id);
      btn.classList.add('saved');
    }
    localStorage.setItem('uponthee_saved', JSON.stringify([...savedIds]));

    fetch('/saved/toggle', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ lodge_id: id }),
    }).catch(() => {});
  }
</script>