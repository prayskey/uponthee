<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lodges — Uponthee</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/src/output.css" />
  <link rel="stylesheet" href="/src/navbar.css" />
  <style>
    body { font-family: 'DM Sans', sans-serif; background: #f8f6f3; }
    @keyframes slideUp { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }
    .lodge-card { opacity:0; animation:slideUp 0.4s cubic-bezier(0.22,1,0.36,1) forwards; transition:transform 0.22s ease,box-shadow 0.22s ease; }
    .lodge-card:hover { transform:translateY(-4px); box-shadow:0 10px 32px rgba(85,20,42,0.09); }
    .lodge-card .img-wrap { overflow:hidden; }
    .lodge-card img { transition:transform 0.45s ease; }
    .lodge-card:hover img { transform:scale(1.05); }
    .save-btn { position:absolute; top:10px; right:10px; z-index:5; width:34px; height:34px; border-radius:50%; background:rgba(255,255,255,0.92); border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; box-shadow:0 2px 8px rgba(0,0,0,0.12); backdrop-filter:blur(4px); transition:transform 0.2s; }
    .save-btn:hover { transform:scale(1.1); }
    .save-btn.saved svg { fill:#55142A; stroke:#55142A; }
    .filter-btn { padding:7px 18px; border-radius:999px; font-size:13px; border:1px solid #e5e7eb; background:white; color:#6b7280; cursor:pointer; font-family:'DM Sans',sans-serif; transition:background 0.15s,color 0.15s,border-color 0.15s; white-space:nowrap; }
    .filter-btn:hover { background:#f9fafb; }
    .filter-btn.active { background:#55142A; color:white; border-color:#55142A; }
    .page-btn { padding:8px 20px; border-radius:10px; border:1px solid #e5e7eb; background:white; font-size:13px; color:#374151; cursor:pointer; font-family:'DM Sans',sans-serif; transition:background 0.15s; }
    .page-btn:hover:not(:disabled) { background:#f9fafb; }
    .page-btn:disabled { opacity:0.4; cursor:not-allowed; }
    .page-btn.active { background:#55142A; color:white; border-color:#55142A; }
    .avail-yes { background:#dcfce7; color:#166534; }
    .avail-no  { background:#fee2e2; color:#991b1b; }
  </style>
</head>
<body class="min-h-screen pt-16">

  <%- include('partials/header.ejs') %>

  <!-- Hero -->
  <div class="bg-[#55142A] px-6 pb-15 pt-11 md:px-12">
    <div class="mx-auto max-w-7xl">
      <p class="mb-2 text-[11px] uppercase tracking-[0.15em] text-[#A79A79]" id="community-label">All communities</p>
      <h1 class="text-4xl font-medium text-white md:text-5xl" style="font-family:'Cormorant Garamond',serif;" id="community-title">Browse Lodges</h1>
      <p class="mt-2 text-[13px] text-white/50">Discover available lodges curated for your stay</p>
    </div>
  </div>

  <main class="mx-auto max-w-7xl px-5 pb-20">

    <!-- Filters + search -->
    <div class="mb-7 mt-8 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap gap-2" id="filter-wrap">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="umuchima">Umuchima</button>
        <button class="filter-btn" data-filter="eziobodo">Eziobodo</button>
        <button class="filter-btn" data-filter="ihiagwa">Ihiagwa</button>
        <button class="filter-btn" data-filter="available">Available</button>
      </div>
      <div class="flex items-center gap-2.5">
        <input type="search" id="lodge-search" placeholder="Search lodges..."
          class="min-w-[180px] rounded-xl border border-gray-200 bg-white px-3.5 py-2 text-[13px] text-gray-900 outline-none transition focus:border-[#55142A] focus:ring-[3px] focus:ring-[#55142A]/8" />
        <select id="sort-select" onchange="sortChanged(this)"
          class="rounded-xl border border-gray-200 bg-white px-3 py-2 text-[13px] text-gray-700 outline-none focus:border-[#55142A]">
          <option value="default">Sort by</option>
          <option value="price-asc">Price: low to high</option>
          <option value="price-desc">Price: high to low</option>
          <option value="rating">Highest rated</option>
        </select>
      </div>
    </div>

    <p class="mb-5 text-[13px] text-gray-400" id="results-count"></p>

    <div id="lodges-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"></div>

    <div id="empty" class="hidden py-20 text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#55142A]/[0.07]">
        <svg class="h-6 w-6 text-[#55142A]/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21"/>
        </svg>
      </div>
      <p class="text-xl text-gray-700" style="font-family:'Cormorant Garamond',serif;">No lodges found</p>
      <p class="mt-1 text-[13px] text-gray-400">Try a different search or filter</p>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-center gap-2" id="pagination"></div>

  </main>

  <%- include('partials/footer.ejs') %>

  <!-- Data injected from Express route -->
  <script>
    const ALL_LODGES = <%- JSON.stringify(typeof lodges !== 'undefined' ? lodges : [
      { id:1,  name:'Sunrise Lodge',  community:'umuchima', price:120000, rating:4.8, available:true,  image:'/images/lodge1.jpg' },
      { id:2,  name:'Prime Lodge',    community:'umuchima', price:150000, rating:4.6, available:true,  image:'/images/lodge2.jpg' },
      { id:3,  name:'Elite Stay',     community:'umuchima', price:180000, rating:4.9, available:false, image:'/images/lodge3.jpg' },
      { id:4,  name:'Budget Lodge',   community:'umuchima', price:90000,  rating:4.3, available:true,  image:'/images/lodge4.jpg' },
      { id:5,  name:'Royal Lodge',    community:'eziobodo', price:130000, rating:4.7, available:true,  image:'/images/lodge5.jpg' },
      { id:6,  name:'Green View',     community:'eziobodo', price:110000, rating:4.4, available:true,  image:'/images/lodge6.jpg' },
      { id:7,  name:'Cedar Hostel',   community:'eziobodo', price:95000,  rating:4.2, available:false, image:'/images/lodge7.jpg' },
      { id:8,  name:'The Retreat',    community:'eziobodo', price:160000, rating:4.8, available:true,  image:'/images/lodge8.jpg' },
      { id:9,  name:'Palm Court',     community:'ihiagwa',  price:105000, rating:4.5, available:true,  image:'/images/lodge9.jpg' },
      { id:10, name:'Haven Lodge',    community:'ihiagwa',  price:140000, rating:4.7, available:true,  image:'/images/lodge10.jpg' },
      { id:11, name:'Campus View',    community:'ihiagwa',  price:85000,  rating:4.1, available:false, image:'/images/lodge11.jpg' },
      { id:12, name:'Silver Hostel',  community:'ihiagwa',  price:125000, rating:4.6, available:true,  image:'/images/lodge12.jpg' },
    ]) %>;
  </script>
  <script src="/js/navbar.js"></script>
  <script src="/js/lodges.js"></script>
</body>
</html>
